df_samples_asm = pd.read_csv("~/MtbLongitudinalDiversity/lowAF_variant_calling/data/personal_assemblies_samples.tsv", sep='\t', header=None)
sample_asm_dict = dict(zip(df_samples_asm[0], df_samples_asm[1]))

for sample in df_samples[0].values:
    if sample not in sample_asm_dict.keys():
        sample_asm_dict[sample] = f"{assembly_dir}/{sample}/assembly/{sample}.fasta"

